# Configuração do ambiente de desenvolvimento (I120, I069). Sem segredos.
# Vazio: os pedidos são relativos (/api/...) e passam pelo proxy do Vite, que evita o CORS.
VITE_API_BASE_URL=
# Destino do proxy do Vite: a API local do katch-backend (perfil http do launchSettings.json).
VITE_PROXY_TARGET=http://localhost:5180
VITE_API_TIMEOUT_MS=9000
