# Copiar para .env.production.local (ignorado pelo Git) e indicar o endereço público da API.
# Na pipeline, o build usa VITE_API_BASE_URL das variáveis do repositório, se existir.
# O proxy do Vite (VITE_PROXY_TARGET, só em desenvolvimento) não se aplica ao build de produção.
VITE_API_BASE_URL=https://<endereço-público-da-api>
VITE_API_TIMEOUT_MS=9000
